# ---------------------------------------------------------------------------
# IclWarnings.cmake
#
# Defines the INTERFACE target icl::warnings: a strict warning set with warnings
# as errors. Link it PRIVATE into every first-party target. Third-party headers
# arrive as SYSTEM includes, so these flags do not fire on dependency code.
#
# The lists are split into a set valid for C and C++ and a C++-only set behind
# $<COMPILE_LANGUAGE:CXX>, so a C source in the tree does not hard-error on
# C++-only options.
#
# ICL_WARNINGS_OFF_FLAG switches warnings off for one source file. Use it on
# code written by generators (moc, rcc, qmlcachegen output), never on code
# written by hand.
# ---------------------------------------------------------------------------

include_guard(GLOBAL)

add_library(icl_warnings INTERFACE)
add_library(icl::warnings ALIAS icl_warnings)

set(_icl_gnu_clang_warnings
    -Wall -Wextra -Wpedantic -Werror -Wshadow -Wcast-align -Wunused
    -Wconversion -Wsign-conversion -Wnull-dereference -Wdouble-promotion
    -Wimplicit-fallthrough -Wformat=2)
set(_icl_gnu_clang_cxx_warnings -Wnon-virtual-dtor -Woverloaded-virtual -Wold-style-cast)
set(_icl_msvc_warnings /W4 /WX)
set(_icl_msvc_cxx_warnings /permissive-)

if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang" AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
    # clang-cl binds -Wall to MSVC's /Wall semantics (every group, including the
    # ones that are off by default), which fails on ordinary code. /W4 plus the
    # GNU-style extras is what clang-cl recommends.
    set(_icl_clang_cl_warnings /W4 -Wextra -Wpedantic -Werror -Wshadow -Wcast-align -Wunused
        -Wconversion -Wsign-conversion -Wnull-dereference -Wdouble-promotion
        -Wimplicit-fallthrough -Wformat=2)
    target_compile_options(icl_warnings INTERFACE
        ${_icl_clang_cl_warnings}
        "$<$<COMPILE_LANGUAGE:CXX>:${_icl_gnu_clang_cxx_warnings}>")
else()
    target_compile_options(icl_warnings INTERFACE
        "$<$<CXX_COMPILER_ID:MSVC>:${_icl_msvc_warnings}>"
        "$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:${_icl_msvc_cxx_warnings}>"
        "$<$<OR:$<CXX_COMPILER_ID:GNU>,$<CXX_COMPILER_ID:Clang>,$<CXX_COMPILER_ID:AppleClang>>:${_icl_gnu_clang_warnings}>"
        "$<$<AND:$<COMPILE_LANGUAGE:CXX>,$<OR:$<CXX_COMPILER_ID:GNU>,$<CXX_COMPILER_ID:Clang>,$<CXX_COMPILER_ID:AppleClang>>>:${_icl_gnu_clang_cxx_warnings}>")
endif()

# Catch2's TEST_CASE and INFO macros use __COUNTER__, which Clang 20+ reports
# under -Wpedantic as a C2y extension. Clang attributes the diagnostic to the
# expansion site (our test sources). Older Clang rejects the unknown option
# under -Werror, so the flag is version-gated.
if(CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$" AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 20)
    target_compile_options(icl_warnings INTERFACE -Wno-c2y-extensions)
endif()

if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
    # C4702 (unreachable code) fires in code generated by qmlcachegen. Narrower
    # than /w, which would clash with /W4 on the same command line (D9025).
    set(ICL_WARNINGS_OFF_FLAG "/wd4702")
else()
    set(ICL_WARNINGS_OFF_FLAG "-w")
endif()

unset(_icl_gnu_clang_warnings)
unset(_icl_gnu_clang_cxx_warnings)
unset(_icl_msvc_warnings)
unset(_icl_msvc_cxx_warnings)
